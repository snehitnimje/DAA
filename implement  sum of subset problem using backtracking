#include <stdio.h>

int a[20];
int n, target;

unsigned int result[1 << 20];
int count = 0;

/* Backtracking function */
void subsetSum(int index, int sum, unsigned int mask)
{
    if (sum == target)
    {
        result[count++] = mask;
        return;
    }

    if (index == n || sum > target)
        return;

    /* Include current element */
    subsetSum(index + 1,
              sum + a[index],
              mask | (1U << index));

    /* Exclude current element */
    subsetSum(index + 1,
              sum,
              mask);
}int main()
{
    int i, j;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &target);

    subsetSum(0, 0, 0);

    if (count == 0)
    {
        printf("-1\n");
        return 0;
    }

    /* Print in reverse order of discovery */
    for (i = count - 1; i >= 0; i--)
    {
        for (j = 0; j < n; j++)
        {
            if (result[i] & (1U << j))
                printf("%d ", a[j]);
        }
        printf("\n");
    }

    return 0;
}
